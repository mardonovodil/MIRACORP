PORT=8787
CRM_ALLOWED_ORIGIN=http://localhost:8787

# Yandex 360 mailbox used for NATURELLO outreach.
YANDEX360_EMAIL=hello@naturello.food
YANDEX360_FROM_NAME=NATURELLO Partnerships

# Use an app password or OAuth token. Never put this value into frontend code.
YANDEX360_PASSWORD=replace_with_app_password_or_oauth_token

# Yandex Mail SMTP/IMAP endpoints.
YANDEX360_SMTP_HOST=smtp.yandex.ru
YANDEX360_SMTP_PORT=465
YANDEX360_IMAP_HOST=imap.yandex.ru
YANDEX360_IMAP_PORT=993

# Start conservatively while warming up the domain.
DAILY_SEND_LIMIT=25

